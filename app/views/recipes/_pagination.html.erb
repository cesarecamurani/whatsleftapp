<% url_for_page = local_assigns.fetch(:url_for_page) {
  ->(page_number) { search_path(ingredients: ingredients, page: page_number) }
} %>
<% page_count = total_pages(total_count) %>

<% if page_count > 1 %>
  <nav class="pagination" aria-label="Pagination">
    <ul class="pagination-list">
      <li>
        <% if page > 1 %>
          <%= link_to "Previous",
                      url_for_page.call(page - 1),
                      class: "pagination-link",
                      rel: "prev" %>
        <% else %>
          <span class="pagination-link pagination-link--disabled" aria-disabled="true">
            Previous
          </span>
        <% end %>
      </li>

      <% pagination_items(page, page_count).each do |item| %>
        <li>
          <% if item == :gap %>
            <span class="pagination-ellipsis" aria-hidden="true">&hellip;</span>
          <% elsif item == page %>
            <span class="pagination-link pagination-link--current" aria-current="page">
              <%= item %>
            </span>
          <% else %>
            <%= link_to item,
                        url_for_page.call(item),
                        class: "pagination-link",
                        "aria-label": "Page #{item}" %>
          <% end %>
        </li>
      <% end %>

      <li>
        <% if page < page_count %>
          <%= link_to "Next",
                      url_for_page.call(page + 1),
                      class: "pagination-link",
                      rel: "next" %>
        <% else %>
          <span class="pagination-link pagination-link--disabled" aria-disabled="true">
            Next
          </span>
        <% end %>
      </li>
    </ul>
  </nav>
<% end %>
